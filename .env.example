# ===== 应用基础 =====
APP_NAME=Enterprise-aiagent
APP_ENV=development
DEBUG=false
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ===== OpenAI 兼容协议（单模型模式，3 个 tier 默认复用此模型）=====
OPENAI_API_KEY=sk-your-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini

# ===== 多模型分层路由（可选；填写 LLM_MODELS 后启用 tier 差异化）=====
# LLM_MODELS 必须是完整 JSON 数组，且整体用双引号包裹；model_id 必填
# LLM_MODELS='[{"model_id":"glm-5.2","priority":0,"supports_thinking":true},{"model_id":"kimi-k2","priority":1,"supports_thinking":true}]'
# LLM_TIER_FAST=glm-5.2
# LLM_TIER_STANDARD=glm-5.2,kimi-k2
# LLM_TIER_DEEP=kimi-k2,glm-5.2
# LLM_TIER_FAST_TIMEOUT_MS=8000
# LLM_TIER_STANDARD_TIMEOUT_MS=25000
# LLM_TIER_DEEP_TIMEOUT_MS=90000

# ===== 向量 Embedding（固定 text-embedding-v3，不进路由）=====
# 复用 OPENAI_API_KEY / OPENAI_API_BASE 作为 DashScope 兼容网关；维度 DIM=1024

# ===== PostgreSQL（异步 asyncpg）=====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=agent_knowledge
MILVUS_KB_COLLECTION_NAME=knowledge_base_v3
# 首次迁移置 true，迁移完成改为 false 保留数据
MILVUS_KB_OVERWRITE=true

# ===== Langfuse 可观测性（留空则不启用）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== Agent 编排开关 =====
ENABLE_SKILL_TOOL_GATING=true
ENABLE_EMPTY_RESULT_REPLAN=true
