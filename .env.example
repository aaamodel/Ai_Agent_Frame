# ===== 应用基础 =====
APP_NAME=Enterprise-aiagent
APP_ENV=development
DEBUG=false
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ===== OpenAI 兼容协议（单模型模式，3 个 tier 默认复用此模型）=====
OPENAI_API_KEY=sk-your-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini

# ===== 多模型分层路由（可选；填写 LLM_MODELS 后启用 tier 差异化）=====
# LLM_MODELS 必须是完整 JSON 数组，且整体用双引号包裹；model_id 必填
# 每条模型可挂不同厂商（独立 base_url + api_key），支持字段：
#   model_id              注册 ID（LLM_TIER_* 引用）；可选 "model" 指定实际 API 模型名
#   provider/api_style    厂商方言：dashscope(百炼,默认按域名推断) / deepseek / zhipu(智谱GLM) / openai
#   base_url / api_key    独立网关与密钥；省略复用 OPENAI_API_BASE / OPENAI_API_KEY
#                         api_key 支持 "${环境变量名}" 引用，避免明文多密钥
#   priority              同 tier 内降级顺序（数字越小越先）
#   supports_thinking     是否支持思考；DEEP tier 至少 1 个 true（否则启动 Fail-Fast）
#   supports_json_schema  是否支持严格 JSON Schema；省略按厂商默认
#                         （dashscope/openai=true；zhipu 智谱 GLM-4.7+=true，更老的 GLM-4.6
#                         需显式配 false；deepseek 官方端点实测仍 400=false，自动降级 json_object，
#                         若走支持 schema 的第三方 DeepSeek 兼容网关可显式配 true）
#   thinking_can_disable  能否显式关闭思考，默认 true；GLM-5.3 等强制思考模型设 false
#
# 百炼 + DeepSeek 官方 + 智谱 GLM 三家混用示例：
# LLM_MODELS='[{"model_id":"qwen3.7-flash","priority":0,"supports_thinking":true},{"model_id":"deepseek-flash","provider":"deepseek","base_url":"https://api.deepseek.com","api_key":"${DEEPSEEK_API_KEY}","priority":1,"supports_thinking":true},{"model_id":"glm-4.7","provider":"zhipu","base_url":"https://open.bigmodel.cn/api/paas/v4","api_key":"${ZHIPU_API_KEY}","priority":2,"supports_thinking":true}]'
# 智谱国际端点 Z.AI 时把 base_url 换成 https://api.z.ai/api/paas/v4、密钥用 ${ZAI_API_KEY}
# LLM_TIER_FAST=qwen3.7-flash
# LLM_TIER_STANDARD=qwen3.7-flash,deepseek-flash,glm-4.7
# LLM_TIER_DEEP=qwen3.7-flash,deepseek-flash
# LLM_TIER_FAST_TIMEOUT_MS=8000
# LLM_TIER_STANDARD_TIMEOUT_MS=25000
# LLM_TIER_DEEP_TIMEOUT_MS=90000

# ===== 向量 Embedding（固定 text-embedding-v3，不进路由）=====
# 复用 OPENAI_API_KEY / OPENAI_API_BASE 作为 DashScope 兼容网关；维度 DIM=1024

# ===== PostgreSQL（异步 asyncpg）=====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=agent_knowledge
MILVUS_KB_COLLECTION_NAME=knowledge_base_v3

# ===== Langfuse 可观测性（留空则不启用）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== Agent 编排开关 =====
ENABLE_SKILL_TOOL_GATING=true
ENABLE_EMPTY_RESULT_REPLAN=true
REACT_MAX_STEPS=10
MAX_REPLAN_ATTEMPTS=2
# summarize 证据充分性自判：计划跑完后由汇总 LLM 一并判定证据是否足够，不足带缺口说明 replan（0 额外调用）
AGENT_EVIDENCE_GATE_ENABLED=true

# ===== 2.2 状态图 checkpoint / HITL 人工审批 =====
# redis（默认，连不上自动降级内存，审批/断点续跑随之失效）或 memory
AGENT_CHECKPOINT_BACKEND=redis
AGENT_CHECKPOINT_TTL_SECONDS=86400
AGENT_CHECKPOINT_PREFIX=agent_cp
# 危险工具人工审批总开关（默认关闭）；开启后命中名单的工具会 interrupt 挂起
AGENT_APPROVAL_ENABLED=false
# 需人工审批的工具名，逗号分隔（默认：Excel 单格写入 + 销售报表导出）
AGENT_DANGER_TOOLS=local_excel_write_tool,sales_report_export_tool
# reflect 质量门（默认关闭）
AGENT_REFLECT_ENABLED=false
AGENT_REFLECT_MIN_SCORE=60
AGENT_NODE_RETRY_MAX=1
